<?xml version="1.0" encoding="UTF-8"?>
<Configuration>
    <Appenders>
        <RollingFile name="RollingFile"
                     fileName="./logs/accountService.log"
                     filePattern="./logs/accountService-%d{-dd-MMMM-yyyy}-%i.log">
            <PatternLayout>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n</pattern>
            </PatternLayout>
            <Policies>
                <!-- rollover on startup, daily and when the file reaches
                    10 MegaBytes -->
                <OnStartupTriggeringPolicy />
                <SizeBasedTriggeringPolicy
                        size="10 MB" />
                <TimeBasedTriggeringPolicy />
            </Policies>
        </RollingFile>
        <RollingFile name="AuditFile"
                     fileName="./logs/accountService-audit.log"
                     filePattern="./logs/accountService-audit-%d{yyyy-MM-dd}-%i.log">
            <PatternLayout>
                <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %msg%n</pattern>
            </PatternLayout>
            <Policies>
                <SizeBasedTriggeringPolicy
                        size="10 MB" />
                <TimeBasedTriggeringPolicy />
            </Policies>
            <DefaultRolloverStrategy max="365" />
        </RollingFile>
    </Appenders>

    <Loggers>
        <!-- One JSON line per committed or failed bills mutation (see AuditServiceImpl) -->
        <Logger name="AUDIT" level="info" additivity="false">
            <AppenderRef ref="AuditFile" />
        </Logger>
        <!-- LOG everything at INFO level -->
        <Root level="info">
            <AppenderRef ref="RollingFile" />
        </Root>
        <Logger name="org.apache" level="debug" additivity="false">
            <AppenderRef ref="RollingFile" />
        </Logger>
        <Logger name="org.springframework" level="info" additivity="false">
            <AppenderRef ref="RollingFile" />
        </Logger>
        <Logger name="org.hibernate" level="info" additivity="false">
            <AppenderRef ref="RollingFile" />
        </Logger>
        <Logger name="org.hibernate.SQL" level="debug" additivity="false">
            <AppenderRef ref="RollingFile" />
        </Logger>
        <Logger name="org.hibernate.SQL" level="trace" additivity="false">
            <AppenderRef ref="RollingFile" />
        </Logger>
    </Loggers>
</Configuration>