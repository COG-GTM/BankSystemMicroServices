<?xml version="1.0" encoding="UTF-8"?>
<Configuration>
    <Properties>
        <!-- Rolled log files hold customer/account identifiers; delete them after this ISO-8601 period -->
        <Property name="LOG_RETENTION_PERIOD">${env:LOG_RETENTION_PERIOD:-P30D}</Property>
        <!-- Set to debug only for local troubleshooting -->
        <Property name="LOG_LEVEL_ORG_APACHE">${env:LOG_LEVEL_ORG_APACHE:-info}</Property>
    </Properties>
    <Appenders>
        <RollingFile name="RollingFile"
                     fileName="./logs/accountService.log"
                     filePattern="./logs/accountService-%d{-dd-MMMM-yyyy}-%i.log">
            <PatternLayout>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n</pattern>
            </PatternLayout>
            <Policies>
                <!-- rollover on startup, daily and when the file reaches
                    10 MegaBytes -->
                <OnStartupTriggeringPolicy />
                <SizeBasedTriggeringPolicy
                        size="10 MB" />
                <TimeBasedTriggeringPolicy />
            </Policies>
            <DefaultRolloverStrategy max="100">
                <Delete basePath="./logs" maxDepth="1">
                    <IfFileName glob="accountService-*.log">
                        <IfLastModified age="${LOG_RETENTION_PERIOD}" />
                    </IfFileName>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>
    </Appenders>

    <Loggers>
        <!-- LOG everything at INFO level -->
        <Root level="info">
            <AppenderRef ref="RollingFile" />
        </Root>
        <Logger name="org.apache" level="${LOG_LEVEL_ORG_APACHE}" additivity="false">
            <AppenderRef ref="RollingFile" />
        </Logger>
        <Logger name="org.springframework" level="info" additivity="false">
            <AppenderRef ref="RollingFile" />
        </Logger>
        <Logger name="org.hibernate" level="info" additivity="false">
            <AppenderRef ref="RollingFile" />
        </Logger>
        <Logger name="org.hibernate.SQL" level="debug" additivity="false">
            <AppenderRef ref="RollingFile" />
        </Logger>
        <Logger name="org.hibernate.SQL" level="trace" additivity="false">
            <AppenderRef ref="RollingFile" />
        </Logger>
    </Loggers>
</Configuration>